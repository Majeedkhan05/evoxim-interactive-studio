# Evoxim AI Experience Platform — Environment Variables
# Copy to .env and fill in values

# Database
DATABASE_URL=sqlite:///./evoxim.db

# LLM Provider (for future RAG integration)
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash

# Supabase (for production auth + storage)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Email (Resend, for production)
EMAIL_API_KEY=

# Analytics (PostHog, optional)
ANALYTICS_KEY=

# App
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Admin (for MVP simple auth)
ADMIN_PASSWORD=evoxim-admin-change-me
