# Database
DATABASE_URL=sqlite:///./evoxim.db

# LLM Integration (optional — MVP uses deterministic engine)
LLM_API_KEY=your-api-key-here
LLM_MODEL=claude-sonnet-4-20250514
LLM_PROVIDER=anthropic

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Proposal defaults
DEFAULT_LANGUAGE=en
COMPANY_EMAIL=info@evoxim.com
COMPANY_PHONE=+1-514-000-0000
COMPANY_WEBSITE=https://evoxim.com
